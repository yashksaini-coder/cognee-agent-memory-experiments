# Copy to .env (git-ignored); `npm run demo` loads it. Leave everything unset for the
# offline rows only. Full reference and the reasons behind each default: src/llm.ts.

# Pick one provider. openai is the default when LLM_PROVIDER is unset.
#   openai             COGNEE_LLM_API_KEY (or OPENAI_API_KEY once LLM_PROVIDER is set)
#   anthropic          workspace-scoped sk-ant-api03- key; local Ollama embeddings
#   ollama             no key; needs `ollama serve` and a pulled model
#   openai_compatible  Groq, OpenRouter, LM Studio, vLLM: needs LLM_ENDPOINT + LLM_MODEL
LLM_PROVIDER=
COGNEE_LLM_API_KEY=

# Optional overrides. Claude 5.x and opus-4-7/4-8 are refused (cognee-ts 0.2.0 always
# sends `temperature`, which they reject); the anthropic default is claude-haiku-4-5.
LLM_MODEL=
LLM_ENDPOINT=

# Embeddings: openai | ollama. Ollama needs `ollama pull nomic-embed-text` (274 MB).
# EMBEDDING_DIMENSIONS is required for any model llm.ts does not already know.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
